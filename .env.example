# ============================================================
# mailOG Environment Variables
# Copy ke .env dan isi sesuai environment deployment
# ============================================================

# PostgreSQL (external service)
DATABASE_URL="postgresql://user:password@host:5432/mailog"

# Port aplikasi (default 3000)
APP_PORT=3000

# Penyimpanan file: local | minio
STORAGE_DRIVER="minio"
UPLOAD_DIR="uploads/surat"

# MinIO (external service — dipakai jika STORAGE_DRIVER=minio)
MINIO_ENDPOINT="minio.example.com"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="your-access-key"
MINIO_SECRET_KEY="your-secret-key"
MINIO_BUCKET="mailog"

# Session (min 32 karakter untuk NUXT_SESSION_PASSWORD)
SESSION_SECRET="change-me-in-production-use-long-random-string"
NUXT_SESSION_PASSWORD="change-me-in-production-use-long-random-string-32chars-at-least"

# URL aplikasi (dipakai untuk redirect URI, dll)
APP_URL="https://mailog.example.com"

# SSO Identity Provider (optional — kosongkan jika tidak pakai)
SSO_ISSUER="https://sso.example.com"
SSO_CLIENT_ID=""
SSO_CLIENT_SECRET=""
SSO_REDIRECT_URI="https://mailog.example.com/api/auth/sso/callback"
SSO_AUTO_PROVISION="true"
