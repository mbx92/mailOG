{"nodes": [{"id": "design_minimax_minimax_design_system", "label": "MiniMax Design System", "file_type": "document", "source_file": "DESIGN-minimax.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Premium AI infrastructure brand identity: stark white canvas with deep-black typographic emphasis for marketing, paired with vibrant gradient product cards that give each model its own visual personality."}, {"id": "design_minimax_dual_identity", "label": "Dual Identity Branding", "file_type": "rationale", "source_file": "DESIGN-minimax.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marketing and platform pages stay monochrome and editorial; each model release gets a saturated gradient identity card so product lines read like distinct album covers on the homepage."}, {"id": "design_minimax_dm_sans", "label": "DM Sans", "file_type": "concept", "source_file": "DESIGN-minimax.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen for dual fluency: scales from 80px hero displays with -2px letter-spacing to 12px micro labels; emphasis via weight (500/600/700) rather than italics; Inter as fallback."}, {"id": "design_minimax_black_pill_cta", "label": "Black Pill CTA", "file_type": "concept", "source_file": "DESIGN-minimax.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dominant interactive signature: rounded-full black primary pills; outline secondary; brand colors reserved for product-identity moments only."}, {"id": "design_minimax_product_color_encoding", "label": "Product Color Encoding", "file_type": "concept", "source_file": "DESIGN-minimax.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each model line has a 