DATABASE_URL="postgresql://mailog:mailog@localhost:5433/mailog"

# Penyimpanan file: local (default) | minio
STORAGE_DRIVER="local"
UPLOAD_DIR="uploads/surat"

# MinIO (opsional — dipakai jika STORAGE_DRIVER=minio)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="mailog-admin"
MINIO_SECRET_KEY="mailog-secret"
MINIO_BUCKET="mailog"

SESSION_SECRET="change-me-in-production-use-long-random-string"
NUXT_SESSION_PASSWORD="change-me-in-production-use-long-random-string-32chars"
APP_URL="http://localhost:3000"
